# QoderGateway environment example
# Copy this file to .env before starting with Docker Compose.

QODER_HOST=0.0.0.0
QODER_PORT=5050

# Management console password.
# Change this after installation.
QODER_ADMIN_PASSWORD=admin

# Optional outbound proxy used by Qoder requests.
# Example for a proxy running on the Windows host:
# QODER_PROXY=http://host.docker.internal:7890
QODER_PROXY=

QODER_ENABLE_DOCUMENTS=1
QODER_ENABLE_LANDING=1

# Optional PAT imported automatically when the account pool is empty.
QODER_PAT=
